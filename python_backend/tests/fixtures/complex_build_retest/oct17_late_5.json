_observation", "precedence": ["explicit_request", "purpose_rules", "style_defaults", "material_defaults"], "style_identities": [], "scopes": [{"scope": "global", "text": "以锚点为南侧入口， 生成一个占地约55×47格的中式庭院建筑群。北侧为两层正厅， 东西两侧分别为单层厢房， 南侧为门楼， 中央保留露天庭院。 正厅每层高5格，厢房净高4格， 四栋建筑各自具有完整屋顶， 不能用一张大屋顶覆盖整个庭院 。用有顶回廊连接门楼、 厢房与正厅， 回廊净宽至少3格。使用灰砖、 白墙、深色木柱和青灰瓦； 正厅使用歇山顶， 厢房使用双坡顶。 庭院设置十字石路、 小水池和花坛， 入口至正厅的中轴通道保持畅通 。所有房屋有可进入的门、 实际窗洞和完整地板， 正厅二层有楼梯可达。", "purposes": [], "styles": [], "structures": []}], "original_text": "以锚点为南侧入口，\n生成一个占地约55×47格的中式庭院建筑群。北侧为两层正厅，\n东西两侧分别为单层厢房，\n南侧为门楼，\n中央保留露天庭院。\n正厅每层高5格，厢房净高4格，\n四栋建筑各自具有完整屋顶，\n不能用一张大屋顶覆盖整个庭院\n。用有顶回廊连接门楼、\n厢房与正厅，\n回廊净宽至少3格。使用灰砖、\n白墙、深色木柱和青灰瓦；\n正厅使用歇山顶，\n厢房使用双坡顶。\n庭院设置十字石路、\n小水池和花坛，\n入口至正厅的中轴通道保持畅通\n。所有房屋有可进入的门、\n实际窗洞和完整地板，\n正厅二层有楼梯可达。", "scope_binding": "lexical_not_component_binding", "unrecognized_text_preserved": true, "limits": ["Alias coverage is finite.", "Observations do not certify generated style or functional rooms."], "materials": []}, "window_language_report": {"schema": "formacraft.window_language.v1", "requirements": []}, "building_use_intent": {"schema": "formacraft.building_use.v1", "detected_uses": [], "scope_status": "unspecified", "bindings": [], "verification_level": "intent_only", "geometry_verified": false}, "building_use_audit": {"schema": "formacraft.building_use_audit.v1", "verification_level": "plan_components_only", "blocking": false, "buildings": []}, "gothic_building_contract": {"schema": "formacraft.gothic_building.v1", "requirements": [], "verification_level": "plan_parameters_only"}, "hosted_style_enrichment": {"schema": "formacraft.hosted_style_enrichment.v1", "geometry_changed": false, "hosts": [{"host_id": "gatehouse_mass", "changes": [], "skipped": [], "style_id": "Chinese_Traditional", "status": "unsupported_style"}, {"host_id": "main_hall_mass", "changes": [], "skipped": [], "style_id": "Chinese_Traditional", "status": "unsupported_style"}, {"host_id": "east_wing_mass", "changes": [], "skipped": [], "style_id": "Chi