      "scopes": [
        {
          "scope": "global",
          "text": "建造一座中世纪风格的水岸磨坊建筑群， 包含一座两层磨坊和一座独立的小仓库。磨坊约长17格、 宽13格，每层高5格， 使用石砖基座、 云杉木梁柱和浅色墙面， 覆盖深色双坡屋顶。 磨坊一层设置工作区， 二层设置储物区， 使用内部楼梯连接， 并为楼梯保留至少2格高净空。 一侧设置直径约7格的装饰水车 ，水车旁建造浅水渠。 一层入口通过宽3格的木桥跨过水渠。小仓库放在磨坊另一侧， 与主楼间隔5格， 通过地面石板路连接。 保留水车、 水渠和木桥的空间关系， 不要把两个建筑合并成一个体块 。",
          "purposes": [
            {
              "id": "industrial",
              "phrase": "仓库",
              "start": 34,
              "status": "requested",
              "part": "building"
            },
            {
              "id": "industrial",
              "phrase": "仓库",
              "start": 177,
              "status": "requested",
              "part": "building"
