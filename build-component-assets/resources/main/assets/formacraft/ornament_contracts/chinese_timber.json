    },
    {
      "property": "includeBrackets",
      "negative": "(?:不要|不设|取消)(?:设置|增加|采用)?(?:斗拱)",
      "positive": "(?:设置|增加)(?:斗拱)"
    },
    {
      "property": "includeSubEaves",
      "negative": "(?:不要|不设|取消)(?:设置|增加|采用)?(?:副檐)",
      "positive": "(?:设置|增加)(?:副檐)"
    }
  ]
}
