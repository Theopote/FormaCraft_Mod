{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FBD diagnostic details inside CapabilityGap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "stage",
    "path",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "parse",
        "typecheck",
        "callgraph",
        "evaluate",
        "geometry"
      ]
    },
    "node": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "layer": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 0
    },
    "actual": {
      "type": "integer",
      "minimum": 0
    }
  }
}
